{
  "name": "@ars2k03/render-deploy",
  "version": "1.0.1",
  "description": "Smart 1-click cloud deploy to Render with auto git and env sync",
  "type": "module",
  "license": "MIT",
  "author": "ars2k03",
  "bin": {
    "ars-deploy": "dist/cli.js",
    "render-deploy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "postinstall": "node -e \"import('node:fs').then(fs => fs.existsSync('./dist/postinstall.js') && import('./dist/postinstall.js'))\""
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ars2k03/ars-render-deploy.git"
  },
  "homepage": "https://github.com/ars2k03/ars-render-deploy#readme",
  "bugs": {
    "url": "https://github.com/ars2k03/ars-render-deploy/issues"
  },
  "keywords": [
    "render",
    "deploy",
    "cli",
    "git-sync",
    "devops",
    "automation"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
